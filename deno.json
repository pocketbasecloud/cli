{
  "tasks": {
    "dev": "deno run -A main.ts",
    "check": "deno check main.ts",
    "test": "deno test -A tests/unit/",
    "test:e2e": "deno test -A tests/e2e/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "build": "deno run -A scripts/release.ts --build-only",
    "release": "deno run -A scripts/release.ts"
  },
  "compilerOptions": { "strict": true, "lib": ["deno.window"] },
  "imports": {
    "pocketbase": "npm:pocketbase@0.26.5",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/fmt": "jsr:@std/fmt@1",
    "@std/encoding/hex": "jsr:@std/encoding@1/hex"
  }
}
